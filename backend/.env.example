SECRET_KEY=change-me
DEBUG=1
DB_NAME=lifepulse
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
# The email id you use for Oracle Cloud (sender for all app emails).
# For Gmail use an App Password (Google Account > Security > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FRONTEND_URL=http://localhost:5173
EMAIL_PORT=587
# Memory attachments. Leave OCI_BUCKET empty to keep files in the local media/ folder.
# For Oracle Object Storage fill all five (keys are "Customer Secret Keys" on your OCI user profile).
OCI_BUCKET=
OCI_NAMESPACE=
OCI_REGION=ap-hyderabad-1
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
